{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "elmira/popular-posts",
	"title": "پرخواننده‌ترین‌ها",
	"category": "elmira",
	"icon": "chart-bar",
	"description": "مقاله‌های پربحث‌تر (بیشترین دیدگاه).",
	"textdomain": "elmira",
	"attributes": {
		"title": {
